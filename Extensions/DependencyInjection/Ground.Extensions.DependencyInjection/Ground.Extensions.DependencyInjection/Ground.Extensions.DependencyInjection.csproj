<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <Nullable>enable</Nullable>	 
	  <IsPackable>true</IsPackable>
	  <Description>Ground.Extensions.DependencyInjection is a library for dependency injection extensions in Ground framework.</Description>
	  <PackageTags>ground dependency injection</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.DependencyModel" Version="10.0.5" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.5" />
    <PackageReference Include="Scrutor" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Ground.Extensions.Abstractions\Ground.Extensions.DependencyInjection.Abstractions\Ground.Extensions.DependencyInjection.Abstractions.csproj" />
  </ItemGroup>
</Project>
