{
  "ApiAuthentication": {
    "Providers": [
        {
            "IgnoreSSL": true,
            "Scheme": "PrimaryIdp",
            "Authority": "https://dev-abbas.eu.auth0.com",
            "JwtTokenConfigOption": 1,
            "UserClaimConvertTypeRules": [
                {
                    "Source": "NID",
                    "Destination": "NationalCode"
                }
            ],
            "Priority": 1
        }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}